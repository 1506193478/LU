{
  "appId": "com.lu.media",
  "appName": "LU",
  "webDir": "www",
  "android": {
    "allowMixedContent": true,
    "appendUserAgent": "LuApp/1.1.0"
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false,
    "appendUserAgent": "LuApp/1.1.0"
  },
  "plugins": {
    "BiometricAuthNative": {
      "allowDeviceCredential": true
    },
    "StatusBar": {
      "style": "DEFAULT",
      "overlaysWebView": true
    }
  }
}
