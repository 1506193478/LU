{
  "name": "lu-media",
  "productName": "LU",
  "version": "1.0.0",
  "description": "LU · 私人媒体库（Windows 桌面端）",
  "main": "main.js",
  "author": "LU",
  "license": "UNLICENSED",
  "scripts": {
    "desktop": "electron .",
    "build-win": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lu.media",
    "productName": "LU",
    "directories": {
      "buildResources": "build-res",
      "output": "dist-win"
    },
    "files": [
      "main.js",
      "www/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "build-res/icon.ico"
    },
    "portable": {
      "artifactName": "LU-windows-portable.exe"
    }
  }
}
